/* Anchor-1 snappyHex 背景盒（mm 制，与 gen_mesh.py 同源 [0,2π]³，2026-11-12）
   y/z 各向外扩 0.2 防圆柱与盒面纯相切产生夹缝（管径 2π=盒宽）；
   x 向严格 [0,L]——两端面即周期 patch（cycX0/cycXL，与 createPatchDict 对齐）。
   背景尺寸 ≈0.3 对齐 tet h0.3 口径（表面细化层级 2 → 表面处 ≈0.075）。
   L=6.283185307，L+0.2=6.483185307（顶点直接写字面值）。 */
FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
convertToMeters 1;

vertices
(
    (0                  -0.2                -0.2)
    (6.283185307179586  -0.2                -0.2)
    (0                   6.483185307179586  -0.2)
    (6.283185307179586   6.483185307179586  -0.2)
    (0                  -0.2                 6.483185307179586)
    (6.283185307179586  -0.2                 6.483185307179586)
    (0                   6.483185307179586   6.483185307179586)
    (6.283185307179586   6.483185307179586   6.483185307179586)
);

blocks
(
    hex (0 1 3 2 4 5 7 6) (21 23 23) simpleGrading (1 1 1)
);

boundary
(
    cycX0
    {
        type patch;
        faces ((0 4 6 2));
    }
    cycXL
    {
        type patch;
        faces ((1 5 7 3));
    }
    boxSides
    {
        type patch;
        faces ((2 6 7 3) (0 1 5 4) (0 1 3 2) (4 5 7 6));
    }
);
