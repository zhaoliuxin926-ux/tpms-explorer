/* TPMS 单胞 Darcy 算例背景盒（mm 制，[0,2π]³，2026-11-12）
   x 向周期（cycX0/cycXL→createPatch 成 cyclic 对）；y/z 六分之一近似=壁面（v1 披露：
   单胞全 PBC 留后续批，v1 目标=管线贯通冒烟）。背景 0.3 同 anchor 口径。 */
FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
convertToMeters 1;

vertices
(
    (0                  0                  0)
    (6.283185307179586  0                  0)
    (0                  6.283185307179586  0)
    (6.283185307179586  6.283185307179586  0)
    (0                  0                  6.283185307179586)
    (6.283185307179586  0                  6.283185307179586)
    (0                  6.283185307179586  6.283185307179586)
    (6.283185307179586  6.283185307179586  6.283185307179586)
);

blocks
(
    hex (0 1 3 2 4 5 7 6) (21 21 21) simpleGrading (1 1 1)
);

boundary
(
    cycX0 { type patch; faces ((0 4 6 2)); }
    cycXL { type patch; faces ((1 5 7 3)); }
    sideY { type wall;  faces ((0 1 5 4) (2 3 7 6)); }
    sideZ { type wall;  faces ((0 1 3 2) (4 5 7 6)); }
);
