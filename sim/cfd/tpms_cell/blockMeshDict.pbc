/* TPMS 单胞 Darcy v2——全 PBC 背景盒（mm 制 [0,2π]³，2026-11-12）
   六面全部周期 patch（x/y/z 三对），无壁面——无限周期介质本征渗透率口径；
   v1（y/z=wall）保留在 blockMeshDict.tpms 作壁面效应对照。 */
FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
convertToMeters 1;

vertices
(
    (0                  0                  0)
    (6.283185307179586  0                  0)
    (0                  6.283185307179586  0)
    (6.283185307179586  6.283185307179586  0)
    (0                  0                  6.283185307179586)
