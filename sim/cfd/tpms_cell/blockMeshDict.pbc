    (0                  6.283185307179586  6.283185307179586)
    (6.283185307179586  6.283185307179586  6.283185307179586)
);

blocks
(
    hex (0 1 3 2 4 5 7 6) (21 21 21) simpleGrading (1 1 1)
);

boundary
(
    cycX0 { type patch; faces ((0 4 6 2)); }
    cycXL { type patch; faces ((1 5 7 3)); }
    cycY0 { type patch; faces ((0 1 5 4)); }
    cycYL { type patch; faces ((2 3 7 6)); }
    cycZ0 { type patch; faces ((0 1 3 2)); }
    cycZL { type patch; faces ((4 5 7 6)); }
);
